# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# typescript
*.tsbuildinfo
next-env.d.ts

# eslint
.eslintcache

# production / build
/build

# verification screenshots from browser probes (Playwright / manual). These are
# throwaway artefacts of "did the page render right" checks — never content and
# never referenced by code. Committed by accident once (cb5cfd1, 34 PNG / 18 MB)
# and removed from the index in 2026-10-17; still recoverable from that commit.
/output/

# legacy Jekyll site leftovers — the old site is kept on disk as a local
# backup only; it is never updated and must never be committed.
/_site/
/.sass-cache/
/Gemfile.lock

# misc / os
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# WorkBuddy agent workspace (local notes, memory, probes) — never pushed.
/.workbuddy/

# env files
.env*

# vercel
.vercel

# raw trip GPS (home-address-level) — never push. Only the sanitized, simplified
# route (content/travel/just-because-route.json, produced by
# scripts/pilgrimage-route.mjs) goes online.
/assets-src/travel-data/

# belt-and-braces: the whole-year GPS export was briefly parked under
# public/assets/pilgrimage/just-because/gps_original/ before being moved to
# assets-src/. public/ is copied verbatim into the static export, so keep this
# rule too — that mistake must never be committable again.
/public/assets/pilgrimage/**/gps_original/
/public/**/gps_original/

# full-resolution gallery originals — the GalleryPhoto/ source dir no longer
# exists and `npm run gallery:gen` exits with "source dir not found". The only
# surviving copy of the 48 camera originals (142 MB) is under
# public/assets/photos/gallery/original/, and that folder is a LOCAL MASTER
# ONLY — never published, never committed (decision 2026-10-18, see the
# `original/` block below). Never rewrite or delete those files in place: they
# are the only copy and they are not in version control.
/GalleryPhoto/

# pilgrimage photo masters — full-resolution ORIGINAL phone shots that still
# carry EXIF GPS. Local master only, never published. Nothing currently lives
# here: the 701 MB original set was retired on 2026-10-16 and the 36 hand-made
# composites moved OUT to assets-src/pilgrimage-masters/ (2026-10-17) because
# they carry no EXIF and are only 30 MB — see the note below.
#
# The rule is kept as a guard, not because a file needs it: this is the path a
# future raw-EXIF import would land in, and it must stay uncommittable by
# default. Do NOT widen it back to cover the composites.
/assets-src/photos/

# belt-and-braces: the masters were briefly parked under public/assets/photos/
# before being moved to assets-src/. public/ is copied verbatim into the static
# export, so keep this rule — a repeat of that mistake must never be committable.
#
# This glob also covers photos/gallery/original/, and that is now deliberate.
# That folder holds the 48 full-resolution camera originals (142 MB) and they
# are NOT published (decision 2026-10-18). They used to be the download tier:
# `npm run gallery:gen` wrote an `originalUrl` into every manifest row pointing
# into it, the lightbox rendered a "download original" button, and because this
# glob kept the folder out of git, a clean CI checkout had none of the files —
# scripts/check-refs.mjs (prebuild) resolves content/ strings against public/
# and exited 1, so the Pages deploy died at build (run #12, 2026-10-17) while
# the same build passed locally where the ignored files were still on disk.
# Committing the tier instead only moved the problem: the 142 MB push timed out
# (HTTP 408) repeatedly. So the download feature was dropped: the script emits
# no `originalUrl`, the lightbox button appears only for a hand-authored
# EXTERNAL link (http/https), and the originals stay on disk as an unpublished
# local master (the GalleryPhoto/ copies are gone).
#
# Keep this glob as written. A `!` re-include rule here makes 142 MB of private
# photos committable again and re-breaks the deploy.
/public/assets/photos/**/original/

# pilgrimage COMPOSITE masters — committed, and deliberately NOT ignored.
#
# 2026-10-17: these 36 jpgs (29.9 MB, avg 850 KB) used to sit under
# assets-src/photos/ and inherited that folder's ignore rule, which was written
# for the 701 MB raw-EXIF original set. They never belonged there: magiconch
# strips EXIF during compositing, so sharp reports 0/36 with EXIF, 0/36 with XMP
# (only ICC, which carries no location). Nothing to protect, and being ignored
# meant the ONLY copy of the hand-made composites — the shipped tier is a 2400px
# webp derivative — lived outside version control.
#
# Hence no rule below. If you ever add one here, you are re-losing the masters.
# Originals (`original/`) still DO go under assets-src/photos/ and stay ignored.

# ── public/data/travel/ — two trip pages, two policies ─────────────────────
#
# Both trip pages keep their generated payload under public/data/travel/<id>/,
# because that is the only place with a URL. The similarity ends there.
#
# ptes-2025: track.json is a byte-for-byte copy of
#   content/travel/ptes-2025/data/track.json, made by `npm run sync:data`
#   (prebuild / predev). It is a pure build artifact — ignored, never committed,
#   regenerated from source. Editing it gets a dirty tree and then an overwrite.
#   Remove a tracked copy with `git rm --cached`; an ignore rule alone leaves the
#   already-tracked files in the index and they keep shipping stale bytes.
#
# just-because: route.json and anitabi-212278.json are NOT artifacts. They are
#   generator outputs with no reproducible source in the repo — route.json is
#   cut from a raw GPS export that lives (gitignored) under
#   assets-src/travel-data/, and anitabi-212278.json is a point-in-time
#   snapshot of a remote dataset. Rebuilding either needs data that is not in
#   git, so they MUST stay committed. Like ptes, no human hand-edits them; that
#   is why they live beside the generated payload instead of in content/.
/public/data/travel/ptes-2025/
!/public/data/travel/just-because/
